// Gavel's own tables (task 1.7). Hand-written SQL in prisma/migrations/*_gavel_init/migration.sql adds what
// Prisma cannot say: the append-only triggers on Bid and Settlement (D-14, D-22), DELETE refused on LotState
// (D-16), the CHECKs, and the lot-ends-after-open trigger. Cents are Int (int4): the boundary refuses a max
// above 2147483647 cents; a lot that needs more is a BigInt migration (D-36).
// Column names are camelCase to match LedgerRow / FoldRow in src/auction/engine/engine.ts.

/// A sale. Its three rule settings are copied from rules/auction.v1.json defaults at creation (D-7).
model Auction {
  id                     String    @id @default(uuid()) @db.Uuid
  orgId                  String    @db.Uuid
  org                    Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name                   String
  softCloseWindowSeconds Int
  maxExtensionSeconds    Int
  buyerPremiumBps        Int
  opensAt                DateTime  @db.Timestamptz(6)
  // D-71 (AX-06): shown on the buyer's invoice and the won notice; trigger: unchanged once the sale has a bid
  paymentDueAt           DateTime? @db.Timestamptz(6)
  pickupText             String    @default("")
  pickupWindowText       String    @default("")
  createdAt              DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(6)
  lots                   Lot[]

  @@index([orgId])
}

/// Catalog data. Nothing here changes once the lot has a bid; closing time lives on LotState.
model Lot {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @db.Uuid
  auctionId    String       @db.Uuid
  auction      Auction      @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  number       Int
  title        String
  description  String       @default("")
  imageUrl     String?
  consignor    String       @default("") // a text field; no consignor model (PRD non-goals)
  startCents   Int // CHECK > 0
  reserveCents Int? // CHECK null or >= startCents
  scheduledEnd DateTime     @db.Timestamptz(6) // trigger: > auction.opensAt
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  state        LotState?
  bids         Bid[]
  settlements  Settlement[]

  @@unique([auctionId, number])
  @@index([orgId])
}

/// D-16: the verified projection the hot path locks. Created with the lot; only placeBid writes it;
/// DELETE refused by trigger; auction:verify fails on any column that differs from fold(ledger).
model LotState {
  lotId          String   @id @db.Uuid
  lot            Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  orgId          String   @db.Uuid
  priceCents     Int
  leaderBidderId String?  @db.Uuid // no FK: V3 checks it names an accepted row's bidder
  leaderMaxCents Int
  leaderSeq      Int?
  bidCount       Int
  acceptedCount  Int
  closesAt       DateTime @db.Timestamptz(6)
  extensionCount Int
}

enum BidderStatus {
  ACTIVE
  SUSPENDED
}

/// A user registered with one house (org): a paddle number. The boundary admits ACTIVE only (brief §4 row 1).
model Bidder {
  id            String               @id @default(uuid()) @db.Uuid
  orgId         String               @db.Uuid
  org           Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId        String               @db.Uuid
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  paddle        Int
  status        BidderStatus         @default(ACTIVE)
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  bids          Bid[]
  statusChanges BidderStatusChange[]

  @@unique([orgId, userId])
  @@unique([orgId, paddle])
}

/// D-70 (AX-05): suspend / reinstate history, insert-only by trigger. `Bidder.status` is its projection:
/// the latest row's `status`, or ACTIVE with no rows. `byUserId` carries no FK, as AuditEvent's actor.
model BidderStatusChange {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @db.Uuid
  bidderId  String       @db.Uuid
  bidder    Bidder       @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  status    BidderStatus // the status from this row on
  reason    String // CHECK not blank
  byUserId  String       @db.Uuid
  changedAt DateTime     @db.Timestamptz(6) // now() from @/core/clock, read after the Bidder row is locked

  @@index([bidderId, changedAt])
  @@index([orgId])
}

/// D-14: one row per well-formed attempt, accepted or rejected, with the state before and after it.
/// Append-only by trigger. `outcome` is the closed set in rules/auction.v1.json (CHECK in the migration).
model Bid {
  id               String   @id @default(uuid()) @db.Uuid
  orgId            String   @db.Uuid
  lotId            String   @db.Uuid
  lot              Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  seq              Int // gap-free, bidCount + 1 under the lock; CHECK >= 1
  bidderId         String   @db.Uuid
  bidder           Bidder   @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  maxCents         Int // CHECK > 0
  placedAt         DateTime @db.Timestamptz(6) // now() read under the lock (D-15); never client-supplied
  idempotencyKey   String
  outcome          String
  accepted         Boolean
  priceBeforeCents Int
  priceAfterCents  Int // CHECK >= priceBeforeCents
  leaderBeforeId   String?  @db.Uuid // no FK, as LotState.leaderBidderId
  leaderAfterId    String?  @db.Uuid
  closesAtBefore   DateTime @db.Timestamptz(6)
  closesAtAfter    DateTime @db.Timestamptz(6) // CHECK >= closesAtBefore
  extended         Boolean

  @@unique([lotId, seq])
  @@unique([lotId, bidderId, idempotencyKey]) // D-17
  @@index([orgId])
  @@index([bidderId])
}

/// D-22: settle(fold(ledger)) written once per closed lot by auction:close; append-only by trigger;
/// auction:verify recomputes it (V8) and checks rulesHash against D-23 (V9).
/// D-44: a correction is a superseding row. The lot's current settlement is the row nothing supersedes. Hand-written
/// in the migration: one first row per lot (partial unique), a predecessor in the same lot (composite FK), the CHECKs.
model Settlement {
  id                String   @id @default(uuid()) @db.Uuid
  orgId             String   @db.Uuid
  lotId             String   @db.Uuid
  supersedesId      String?  @unique @db.Uuid // null on the first row; unique, so a chain cannot fork
  reason            String? // required on a correction (CHECK)
  correctedByUserId String?  @db.Uuid // no FK, as AuditEvent.actorUserId; required on a correction (CHECK)
  premiumBps        Int // the rate premiumCents was taken at; the auction's on the first row
  lot               Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  outcome           String // SOLD | UNSOLD_NO_BIDS | UNSOLD_RESERVE_NOT_MET, or UNSOLD_BY_CORRECTION on a correction (CHECK)
  winnerBidderId    String?  @db.Uuid
  winningSeq        Int?
  hammerCents       Int
  premiumCents      Int // the one roundHalfUp
  totalCents        Int // CHECK = hammerCents + premiumCents
  closedAt          DateTime @db.Timestamptz(6)
  rulesHash         String
  createdAt         DateTime @default(now()) @db.Timestamptz(6)

  @@index([orgId])
  @@index([lotId])
}
