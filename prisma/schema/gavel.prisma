// Gavel's own tables (task 1.7). Hand-written SQL in prisma/migrations/*_gavel_init/migration.sql adds what
// Prisma cannot say: the append-only triggers on Bid and Settlement (D-14, D-22), DELETE refused on LotState
// (D-16), the CHECKs, and the lot-ends-after-open trigger. Cents are Int (int4): the boundary refuses a max
// above 2147483647 cents; a lot that needs more is a BigInt migration (D-36).
// Column names are camelCase to match LedgerRow / FoldRow in src/auction/engine/engine.ts.

/// A sale. Its three rule settings are copied from rules/auction.v1.json defaults at creation (D-7).
model Auction {
  id                     String                @id @default(uuid()) @db.Uuid
  orgId                  String                @db.Uuid
  org                    Org                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name                   String
  softCloseWindowSeconds Int
  maxExtensionSeconds    Int
  buyerPremiumBps        Int
  opensAt                DateTime              @db.Timestamptz(6)
  // D-71 (AX-06): shown on the buyer's invoice and the won notice; trigger: unchanged once the sale has a bid
  paymentDueAt           DateTime?             @db.Timestamptz(6)
  pickupText             String                @default("")
  pickupWindowText       String                @default("")
  // D-78 (AX-09): sales tax as configuration, fixed with the terms above once the sale has a bid. 0 = no tax line.
  taxBps                 Int                   @default(0) // CHECK 0..10000
  taxBase                String                @default("HAMMER") // HAMMER | HAMMER_PLUS_PREMIUM (CHECK)
  createdAt              DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime              @updatedAt @db.Timestamptz(6)
  lots                   Lot[]
  terms                  AuctionTerms[]
  termsAcceptances       TermsAcceptance[]
  contracts              ConsignmentContract[]
  paymentMarks           PaymentMark[]
  buyerDefaults          BuyerDefault[]

  @@index([orgId])
}

/// D-72 (AX-03): the terms of sale, one row per version, insert-only by trigger. `sha256` is of `text`; it is what a
/// TermsAcceptance names and what placeBid's boundary compares. A BEFORE INSERT trigger refuses a new version once any
/// lot of the sale has a Bid row (R-03, as D-21 and D-71). A sale with no rows asks nothing of its bidders.
model AuctionTerms {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  auctionId   String   @db.Uuid
  auction     Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  version     Int // CHECK >= 1; max + 1 in the sale, the unique index is the guard
  text        String // CHECK not blank
  sha256      String // CHECK 64 hex chars
  byUserId    String   @db.Uuid
  publishedAt DateTime @db.Timestamptz(6) // now() from @/core/clock

  @@unique([auctionId, version])
  @@index([orgId])
}

/// D-72 (AX-03): a bidder accepted one version of a sale's terms, named by hash. Insert-only by trigger; a second
/// acceptance of the same version is the same row (unique). Never written by the bid path.
model TermsAcceptance {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  auctionId   String   @db.Uuid
  auction     Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderId    String   @db.Uuid
  bidder      Bidder   @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  termsSha256 String
  acceptedAt  DateTime @db.Timestamptz(6) // now() from @/core/clock

  @@unique([auctionId, bidderId, termsSha256])
  @@index([orgId])
}

/// Catalog data. Nothing here changes once the lot has a bid; closing time lives on LotState.
model Lot {
  id           String         @id @default(uuid()) @db.Uuid
  orgId        String         @db.Uuid
  auctionId    String         @db.Uuid
  auction      Auction        @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  number       Int
  title        String
  description  String         @default("")
  imageUrl     String?
  consignor    String         @default("") // free text, kept for rows older than D-74; new lots use consignorId
  consignorId  String?        @db.Uuid // D-74 (AX-07): the consignor the statement is drawn for
  consignorRef Consignor?     @relation(fields: [consignorId], references: [id], onDelete: Restrict)
  startCents   Int // CHECK > 0
  reserveCents Int? // CHECK null or >= startCents
  scheduledEnd DateTime       @db.Timestamptz(6) // trigger: > auction.opensAt
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  state        LotState?
  withdrawal   LotWithdrawal?
  bids         Bid[]
  settlements  Settlement[]
  offers       SecondChanceOffer[]

  @@unique([auctionId, number])
  @@index([orgId])
  @@index([consignorId])
}

/// D-74 (AX-07): a consignor of the house. Reference data (name, code); the money terms are on the contract.
model Consignor {
  id        String                @id @default(uuid()) @db.Uuid
  orgId     String                @db.Uuid
  org       Org                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  code      String // CHECK not blank; unique per house
  createdAt DateTime              @default(now()) @db.Timestamptz(6)
  lots      Lot[]
  contracts ConsignmentContract[]

  @@unique([orgId, code])
  @@index([orgId])
}

/// D-74 (AX-07): the terms between one consignor and one sale, insert-only by trigger; a change is a superseding row
/// (`supersedesId` unique, so a chain cannot fork). The current contract is the row no other row supersedes. Flat
/// commission in bps (CHECK 0..10000), a fee per sold lot and a fee per lot unsold at the block (CHECK >= 0).
model ConsignmentContract {
  id             String               @id @default(uuid()) @db.Uuid
  orgId          String               @db.Uuid
  consignorId    String               @db.Uuid
  consignor      Consignor            @relation(fields: [consignorId], references: [id], onDelete: Cascade)
  auctionId      String               @db.Uuid
  auction        Auction              @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  supersedesId   String?              @unique @db.Uuid
  supersedes     ConsignmentContract? @relation("ContractChain", fields: [supersedesId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supersededBy   ConsignmentContract? @relation("ContractChain")
  commissionBps  Int
  lotFeeCents    Int
  unsoldFeeCents Int
  byUserId       String               @db.Uuid // no FK, as AuditEvent.actorUserId
  createdAt      DateTime             @db.Timestamptz(6) // from @/core/clock, never a default

  @@index([consignorId, auctionId])
  @@index([auctionId])
  @@index([orgId])
}

/// D-16: the verified projection the hot path locks. Created with the lot; only placeBid writes it;
/// DELETE refused by trigger; auction:verify fails on any column that differs from fold(ledger).
model LotState {
  lotId          String   @id @db.Uuid
  lot            Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  orgId          String   @db.Uuid
  priceCents     Int
  leaderBidderId String?  @db.Uuid // no FK: V3 checks it names an accepted row's bidder
  leaderMaxCents Int
  leaderSeq      Int?
  bidCount       Int
  acceptedCount  Int
  closesAt       DateTime @db.Timestamptz(6)
  extensionCount Int
}

/// D-73 (AX-04): staff withdrew the lot. One row per lot, insert-only by trigger. The engine reads `withdrawnAt` as the
/// lot's one input beside the ledger: CLOSED from that instant, every later attempt REJECTED_LOT_WITHDRAWN (a Bid row),
/// settlement UNSOLD_WITHDRAWN closed at `withdrawnAt`. Written under FOR UPDATE on the lot's LotState row with the clock
/// read after the lock; LotState itself is not written. A BEFORE INSERT trigger refuses a lot already closed or settled.
/// `byUserId` carries no FK, as AuditEvent's actor.
model LotWithdrawal {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  lotId       String   @unique @db.Uuid
  lot         Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  reason      String // CHECK not blank
  byUserId    String   @db.Uuid
  withdrawnAt DateTime @db.Timestamptz(6) // now() from @/core/clock, read after the LotState row is locked

  @@index([orgId])
}

enum BidderStatus {
  ACTIVE
  SUSPENDED
}

/// A user registered with one house (org): a paddle number. The boundary admits ACTIVE only (brief §4 row 1).
model Bidder {
  id            String               @id @default(uuid()) @db.Uuid
  orgId         String               @db.Uuid
  org           Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId        String               @db.Uuid
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  paddle        Int
  status        BidderStatus         @default(ACTIVE)
  taxExemptRef  String? // D-78: resale/exemption certificate reference on file; null = taxable (CHECK not blank)
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  bids          Bid[]
  statusChanges BidderStatusChange[]
  termsAccepted TermsAcceptance[]
  paymentMarks  PaymentMark[]
  defaults      BuyerDefault[]
  offers        SecondChanceOffer[]

  @@unique([orgId, userId])
  @@unique([orgId, paddle])
}

/// D-70 (AX-05): suspend / reinstate history, insert-only by trigger. `Bidder.status` is its projection:
/// the latest row's `status`, or ACTIVE with no rows. `byUserId` carries no FK, as AuditEvent's actor.
model BidderStatusChange {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @db.Uuid
  bidderId  String       @db.Uuid
  bidder    Bidder       @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  status    BidderStatus // the status from this row on
  reason    String // CHECK not blank
  byUserId  String       @db.Uuid
  changedAt DateTime     @db.Timestamptz(6) // now() from @/core/clock, read after the Bidder row is locked

  @@index([bidderId, changedAt])
  @@index([orgId])
}

/// D-14: one row per well-formed attempt, accepted or rejected, with the state before and after it.
/// Append-only by trigger. `outcome` is the closed set in rules/auction.v1.json (CHECK in the migration).
model Bid {
  id               String   @id @default(uuid()) @db.Uuid
  orgId            String   @db.Uuid
  lotId            String   @db.Uuid
  lot              Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  seq              Int // gap-free, bidCount + 1 under the lock; CHECK >= 1
  bidderId         String   @db.Uuid
  bidder           Bidder   @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  maxCents         Int // CHECK > 0
  placedAt         DateTime @db.Timestamptz(6) // now() read under the lock (D-15); never client-supplied
  idempotencyKey   String
  outcome          String
  accepted         Boolean
  priceBeforeCents Int
  priceAfterCents  Int // CHECK >= priceBeforeCents
  leaderBeforeId   String?  @db.Uuid // no FK, as LotState.leaderBidderId
  leaderAfterId    String?  @db.Uuid
  closesAtBefore   DateTime @db.Timestamptz(6)
  closesAtAfter    DateTime @db.Timestamptz(6) // CHECK >= closesAtBefore
  extended         Boolean

  @@unique([lotId, seq])
  @@unique([lotId, bidderId, idempotencyKey]) // D-17
  @@index([orgId])
  @@index([bidderId])
}

/// D-22: settle(fold(ledger)) written once per closed lot by auction:close; append-only by trigger;
/// auction:verify recomputes it (V8) and checks rulesHash against D-23 (V9).
/// D-44: a correction is a superseding row. The lot's current settlement is the row nothing supersedes. Hand-written
/// in the migration: one first row per lot (partial unique), a predecessor in the same lot (composite FK), the CHECKs.
model Settlement {
  id                String   @id @default(uuid()) @db.Uuid
  orgId             String   @db.Uuid
  lotId             String   @db.Uuid
  supersedesId      String?  @unique @db.Uuid // null on the first row; unique, so a chain cannot fork
  reason            String? // required on a correction (CHECK)
  correctedByUserId String?  @db.Uuid // no FK, as AuditEvent.actorUserId; required on a correction (CHECK)
  premiumBps        Int // the rate premiumCents was taken at; the auction's on the first row
  lot               Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  outcome           String // SOLD | UNSOLD_NO_BIDS | UNSOLD_RESERVE_NOT_MET, or UNSOLD_BY_CORRECTION on a correction (CHECK)
  winnerBidderId    String?  @db.Uuid
  winningSeq        Int?
  hammerCents       Int
  premiumCents      Int // the one roundHalfUp
  totalCents        Int // CHECK = hammerCents + premiumCents
  closedAt          DateTime @db.Timestamptz(6)
  rulesHash         String
  createdAt         DateTime @default(now()) @db.Timestamptz(6)

  @@index([orgId])
  @@index([lotId])
}

/// D-75 (AX-08, R-08): a payment staff recorded against a buyer's invoice (one sale, one bidder). Insert-only by trigger;
/// a wrong mark is a dispute, not an edit. Payments themselves are a non-goal: this is a mark, never a charge. The invoice
/// status (PAID / PARTIAL / UNPAID / OVERDUE / CREDIT / DEFAULTED) is derived by `invoiceBalance`, never stored.
model PaymentMark {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  auctionId   String   @db.Uuid
  auction     Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderId    String   @db.Uuid
  bidder      Bidder   @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  amountCents Int // CHECK > 0
  method      String // CHECK not blank; free text: cash, check, wire, card terminal
  byUserId    String   @db.Uuid // no FK, as AuditEvent's actor
  markedAt    DateTime @db.Timestamptz(6) // now() from @/core/clock

  @@index([auctionId, bidderId])
  @@index([orgId])
}

/// D-75: a buyer declared in default on one sale's invoice, after the due date, by staff with a reason. Insert-only, one
/// per (sale, bidder). Declaring it suspends the bidder (D-70) and writes one SecondChanceOffer per won lot that has an
/// underbidder. There is no un-default: a wrong one is reinstated on the bidders page and the dispute is in the audit log.
model BuyerDefault {
  id         String              @id @default(uuid()) @db.Uuid
  orgId      String              @db.Uuid
  auctionId  String              @db.Uuid
  auction    Auction             @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderId   String              @db.Uuid
  bidder     Bidder              @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  reason     String // CHECK not blank
  byUserId   String              @db.Uuid
  declaredAt DateTime            @db.Timestamptz(6)
  offers     SecondChanceOffer[]

  @@unique([auctionId, bidderId])
  @@index([orgId])
}

/// D-75: the lot offered to the underbidder after a default, at D-44's price (`secondChance`), to be answered by `expiresAt`.
/// Insert-only. Open until an OfferResponse row names it; expired is derived from the clock, never written.
model SecondChanceOffer {
  id         String         @id @default(uuid()) @db.Uuid
  orgId      String         @db.Uuid
  defaultId  String         @db.Uuid
  default    BuyerDefault   @relation(fields: [defaultId], references: [id], onDelete: Restrict)
  lotId      String         @db.Uuid
  lot        Lot            @relation(fields: [lotId], references: [id], onDelete: Cascade)
  bidderId   String         @db.Uuid // the underbidder
  bidder     Bidder         @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  priceCents Int // CHECK > 0: the hammer the acceptance will settle at
  premiumBps Int // the rate the acceptance keeps
  expiresAt  DateTime       @db.Timestamptz(6)
  createdAt  DateTime       @db.Timestamptz(6) // now() from @/core/clock
  response   OfferResponse?

  @@unique([defaultId, lotId])
  @@index([lotId])
  @@index([bidderId])
  @@index([orgId])
}

/// D-75: the one answer to an offer, recorded by staff; `offerId` unique, so a second answer is refused by the database.
/// ACCEPTED is written in the same transaction as the D-44 settlement correction it causes. Insert-only.
model OfferResponse {
  id          String            @id @default(uuid()) @db.Uuid
  orgId       String            @db.Uuid
  offerId     String            @unique @db.Uuid
  offer       SecondChanceOffer @relation(fields: [offerId], references: [id], onDelete: Restrict)
  response    String // CHECK ACCEPTED | DECLINED
  byUserId    String            @db.Uuid
  respondedAt DateTime          @db.Timestamptz(6)

  @@index([orgId])
}
