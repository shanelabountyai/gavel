# Gavel — variable NAMES only. Copy to .env.local (gitignored) and fill in locally. The foundation's own
# variables (DATABASE_URL, DIRECT_URL, AUTH_SECRET, APP_URL, ...) arrive with the clone; keep its .env.example
# entries and add these. Local DATABASE_URLs carry ?connection_limit=10&pool_timeout=20 (D-2).
DATABASE_URL=
DIRECT_URL=
AUTH_SECRET=
APP_URL=
# Bid path (D-13, O-8): lock wait in ms before BID_TIMED_OUT; Prisma's transaction timeout is set above it in code.
GAVEL_LOCK_TIMEOUT_MS=
# Contention test (D-18, O-10): writers released together; CI sets 25, local runs 50.
GAVEL_BARRIER_N=
