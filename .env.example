# Names only. Copy to .env.local and fill in. Must match src/core/env.ts exactly (INV-14).
NODE_ENV=
DATABASE_URL=
DIRECT_URL=
DATABASE_URL_SYSTEM=
RLS_MODE=
AUTH_SECRET=
APP_URL=
CRON_SECRET=
ALLOW_CLOUD_DB=
VERCEL_ENV=
DEMO_MODE=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_SANDBOX_TO=
EMAIL_ENABLED=
AI_ENABLED=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_SANDBOX_TO=
SMS_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Gavel (D-13/O-8, D-18/O-10). Not in src/core/env.ts (template-owned), so INV-14 forbids them as live lines here;
# read with process.env in the bid path and the contention test, defaults 5000 and 50. Set them in .env.local/.env.test:
#   GAVEL_LOCK_TIMEOUT_MS=5000   lock wait in ms before BID_TIMED_OUT; Prisma's transaction timeout is set above it in code
#   GAVEL_BARRIER_N=50           writers released together; CI sets 25
# SSO module (v1.6.0). SSO_ENABLED=1 turns it on; the SSO_TEST_* keys are read only by seed:demo (never commit values).
SSO_ENABLED=
SSO_TEST_GOOGLE_CLIENT_ID=
SSO_TEST_GOOGLE_CLIENT_SECRET=
SSO_TEST_GOOGLE_DOMAIN=
SSO_TEST_OKTA_ISSUER=
SSO_TEST_OKTA_CLIENT_ID=
SSO_TEST_OKTA_CLIENT_SECRET=
SSO_TEST_OKTA_DOMAIN=

# apikeys module (v1.6.0). Test only: lets webhook endpoints be http://localhost. Refused in production.
WEBHOOK_ALLOW_PRIVATE=
