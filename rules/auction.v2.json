{
  "version": "auction.v2",
  "money": "integer cents",
  "rounding": "half_up",
  "increments": {
    "note": "Named tables; each sale picks one (Auction.incrementTable, default_table when unset). Bands are [lo, hi) in cents; hi null means open-ended. increment_for(price) is the increment of the band containing price. standard is the v1 table, byte for byte.",
    "default_table": "standard",
    "tables": {
      "standard": [
        { "lo_cents": 0, "hi_cents": 10000, "increment_cents": 100 },
        { "lo_cents": 10000, "hi_cents": 50000, "increment_cents": 500 },
        { "lo_cents": 50000, "hi_cents": 100000, "increment_cents": 1000 },
        { "lo_cents": 100000, "hi_cents": 500000, "increment_cents": 2500 },
        { "lo_cents": 500000, "hi_cents": 1000000, "increment_cents": 5000 },
        { "lo_cents": 1000000, "hi_cents": 2500000, "increment_cents": 10000 },
        { "lo_cents": 2500000, "hi_cents": null, "increment_cents": 25000 }
      ],
      "equipment": [
        { "lo_cents": 0, "hi_cents": 10000, "increment_cents": 500 },
        { "lo_cents": 10000, "hi_cents": 100000, "increment_cents": 2500 },
        { "lo_cents": 100000, "hi_cents": 500000, "increment_cents": 5000 },
        { "lo_cents": 500000, "hi_cents": 2500000, "increment_cents": 10000 },
        { "lo_cents": 2500000, "hi_cents": 10000000, "increment_cents": 25000 },
        { "lo_cents": 10000000, "hi_cents": null, "increment_cents": 50000 }
      ],
      "estate": [
        { "lo_cents": 0, "hi_cents": 2000, "increment_cents": 50 },
        { "lo_cents": 2000, "hi_cents": 10000, "increment_cents": 100 },
        { "lo_cents": 10000, "hi_cents": 25000, "increment_cents": 250 },
        { "lo_cents": 25000, "hi_cents": 50000, "increment_cents": 500 },
        { "lo_cents": 50000, "hi_cents": 100000, "increment_cents": 1000 },
        { "lo_cents": 100000, "hi_cents": 500000, "increment_cents": 2500 },
        { "lo_cents": 500000, "hi_cents": null, "increment_cents": 5000 }
      ]
    }
  },
  "premium": {
    "note": "A sale's buyer's premium is a list of premium_bands [lo, hi) over the hammer in cents, contiguous from 0, the last open-ended, bps 0..10000 each. Each band's rate applies to the slice of the hammer inside it; the slices are summed exactly and rounded half up once (premium = round_half_up(sum(slice x bps), 10000)). One band is a flat rate. The default below is copied onto a sale at creation."
  },
  "defaults": {
    "soft_close_window_seconds": 120,
    "max_extension_seconds": 1800,
    "premium_bands": [{ "lo_cents": 0, "hi_cents": null, "bps": 1500 }]
  },
  "outcomes": {
    "accepted": ["ACCEPTED_LEAD", "ACCEPTED_OUTBID", "ACCEPTED_RAISE"],
    "rejected": ["REJECTED_LOT_NOT_OPEN", "REJECTED_LOT_CLOSED", "REJECTED_BELOW_MINIMUM", "REJECTED_NOT_ABOVE_OWN_MAX", "REJECTED_LOT_WITHDRAWN"],
    "not_written": ["REPLAY", "IDEMPOTENCY_MISMATCH", "VOID_LOT_NOT_OPEN", "VOID_NO_LIVE_BIDS"],
    "voided": ["VOIDED"]
  },
  "settlement_outcomes": ["SOLD", "UNSOLD_NO_BIDS", "UNSOLD_RESERVE_NOT_MET", "UNSOLD_WITHDRAWN"]
}
